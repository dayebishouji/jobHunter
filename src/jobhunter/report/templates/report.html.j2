{# === v0.1.12 — Motion polish (去 AI 味) ===
   Inline JS for scroll-reveal + KPI counter animation. All gated by
   prefers-reduced-motion. No external deps — preserves single-file portability. #}
<script>
(function () {
  'use strict';
  var prefersReduced = window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- Reveal-on-scroll ----------
  // Auto-mark top-level sections; stagger axis-ribbon cells + hero side cards.
  var revealTargets = document.querySelectorAll(
    '.chapter, .hero, .axis-ribbon, .hero-ring, .hero-radar, .masthead'
  );
  var idx = 0;
  revealTargets.forEach(function (el) {
    el.classList.add('reveal');
    if (idx < 4) {
      el.style.setProperty('--reveal-delay', (idx * 80) + 'ms');
    }
    idx++;
  });

  // ---------- Counter animation on KPI numbers ----------
  // Axis ribbon numbers (.axis-ribbon-num) — pure integers.
  // Stat strip values (.stat-val[data-counter]) — may include decimals.
  var axisNums = document.querySelectorAll('.axis-ribbon-num');
  axisNums.forEach(function (el) {
    var raw = el.textContent.trim();
    var num = parseFloat(raw);
    if (!isNaN(num)) {
      el.setAttribute('data-counter', String(num));
      el.setAttribute('data-counter-decimals', '0');
      if (!prefersReduced) el.textContent = '0';
    }
  });
  // Stat values with explicit data-counter (set by builder if any)
  var statVals = document.querySelectorAll('.stat-val[data-counter]');
  statVals.forEach(function (el) {
    if (!prefersReduced) {
      var d = parseInt(el.getAttribute('data-counter-decimals') || '0', 10);
      el.textContent = (0).toFixed(d);
    }
  });

  function tickCounter(el) {
    var target = parseFloat(el.getAttribute('data-counter'));
    if (isNaN(target)) return;
    var decimals = parseInt(el.getAttribute('data-counter-decimals') || '0', 10);
    var duration = 700;
    var start = null;
    function step(ts) {
      if (start === null) start = ts;
      var t = Math.min(1, (ts - start) / duration);
      // easeOutCubic
      var eased = 1 - Math.pow(1 - t, 3);
      el.textContent = (target * eased).toFixed(decimals);
      if (t < 1) {
        requestAnimationFrame(step);
      } else {
        el.textContent = target.toFixed(decimals);
        el.classList.add('is-countered');
      }
    }
    requestAnimationFrame(step);
  }

  if (!('IntersectionObserver' in window)) {
    // Fallback: just reveal everything + tick to final value
    revealTargets.forEach(function (el) { el.classList.add('is-visible'); });
    axisNums.forEach(function (el) {
      el.textContent = el.getAttribute('data-counter');
    });
    statVals.forEach(function (el) {
      var d = parseInt(el.getAttribute('data-counter-decimals') || '0', 10);
      el.textContent = parseFloat(el.getAttribute('data-counter')).toFixed(d);
    });
    return;
  }

  var revealObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObs.unobserve(entry.target);
      }
    });
  }, { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
  revealTargets.forEach(function (el) { revealObs.observe(el); });

  // Counter observer — only fires when the number scrolls into view
  var counterTargets = [].slice.call(axisNums).concat([].slice.call(statVals));
  if (counterTargets.length) {
    if (prefersReduced) {
      counterTargets.forEach(function (el) {
        var d = parseInt(el.getAttribute('data-counter-decimals') || '0', 10);
        el.textContent = parseFloat(el.getAttribute('data-counter')).toFixed(d);
      });
    } else {
      var counterObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            tickCounter(entry.target);
            counterObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.4 });
      counterTargets.forEach(function (el) { counterObs.observe(el); });
    }
  }

  // ---------- v0.1.13 — Chapter drag-reorder ----------
  // Native HTML5 drag-and-drop on .chapter elements inside #chapters-container.
  // Order is persisted to localStorage so the user can craft a personalized export.
  // Gated by prefers-reduced-motion for the visual indicator; drag itself is fine.
  var chaptersContainer = document.getElementById('chapters-container');
  var reorderReset = document.getElementById('reorder-reset');
  if (chaptersContainer) {
    var chapters = chaptersContainer.querySelectorAll('.chapter');
    var dragSrcKey = null;
    var STORAGE_KEY = 'jobhunter-chapter-order-v1';

    function getStoredOrder() {
      try {
        var raw = window.localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (e) { return null; }
    }
    function setStoredOrder(order) {
      try { window.localStorage.setItem(STORAGE_KEY, JSON.stringify(order)); } catch (e) {}
    }
    function clearStoredOrder() {
      try { window.localStorage.removeItem(STORAGE_KEY); } catch (e) {}
    }
    function currentOrder() {
      return Array.prototype.map.call(chapters, function (c) {
        return c.getAttribute('data-chapter-key') || c.id;
      });
    }
    function applyOrder(order) {
      if (!order || !order.length) return false;
      var byKey = {};
      Array.prototype.forEach.call(chapters, function (c) {
        var k = c.getAttribute('data-chapter-key') || c.id;
        byKey[k] = c;
      });
      var placed = 0;
      order.forEach(function (k) {
        var node = byKey[k];
        if (node) {
          chaptersContainer.appendChild(node);
          placed++;
        }
      });
      return placed > 0;
    }
    function showReset(show) {
      if (!reorderReset) return;
      if (show) reorderReset.removeAttribute('hidden');
      else reorderReset.setAttribute('hidden', '');
    }

    // Restore previous order on load
    var stored = getStoredOrder();
    var defaultOrder = currentOrder();
    if (stored && JSON.stringify(stored) !== JSON.stringify(defaultOrder)) {
      applyOrder(stored);
      showReset(true);
    }

    chapters.forEach(function (chapter) {
      chapter.addEventListener('dragstart', function (e) {
        dragSrcKey = chapter.getAttribute('data-chapter-key') || chapter.id;
        chapter.classList.add('dragging');
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          try { e.dataTransfer.setData('text/plain', dragSrcKey); } catch (err) {}
        }
      });
      chapter.addEventListener('dragend', function () {
        chapter.classList.remove('dragging');
        chapters.forEach(function (c) { c.classList.remove('drag-over'); });
      });
      chapter.addEventListener('dragover', function (e) {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
        chapter.classList.add('drag-over');
      });
      chapter.addEventListener('dragleave', function () {
        chapter.classList.remove('drag-over');
      });
      chapter.addEventListener('drop', function (e) {
        e.preventDefault();
        chapter.classList.remove('drag-over');
        if (!dragSrcKey) return;
        var srcEl = chaptersContainer.querySelector('[data-chapter-key="' + dragSrcKey + '"]');
        if (!srcEl || srcEl === chapter) return;
        // Insert src before target
        chaptersContainer.insertBefore(srcEl, chapter);
        var newOrder = currentOrder();
        setStoredOrder(newOrder);
        showReset(true);
      });
    });

    if (reorderReset) {
      reorderReset.addEventListener('click', function () {
        clearStoredOrder();
        applyOrder(defaultOrder);
        showReset(false);
      });
    }
  }
})();
</script>
</body>
</html>
