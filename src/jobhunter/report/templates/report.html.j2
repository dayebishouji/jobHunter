{# ============================================================
   III. 司法风险
   ============================================================ #}
<section class="chapter" id="ch-judicial" data-chapter-key="judicial">
  <header class="chapter-head">
    <div class="chapter-num">III</div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">司法风险 {{ conf_badge('judicial') }}</h2>
      <p class="chapter-dek">诉讼、被执行 — 是历史欠账还是经营常态</p>
    </div>
  </header>

  {{ story_block('judicial') }}

  {% set jf = data.judicial_facts %}
  {% if jf %}
    {% if (jf.case_count_total or 0) == 0 %}
    <div class="chapter-takeaway chapter-takeaway-good">
      <span class="chapter-takeaway-tag">结论</span>
      公开记录中未发现诉讼或被执行 — 同行里相对少见的干净背景
    </div>
    {% elif (jf.case_count_total or 0) > 0 %}
    <div class="chapter-takeaway chapter-takeaway-bad">
      <span class="chapter-takeaway-tag">警示</span>
      公开记录发现 {{ jf.case_count_total }} 起诉讼或被执行, 详见下方时间线
    </div>
    {% endif %}

    {% if case_buckets %}
    <div class="data-table">
      <div class="data-row data-row-head">
        <div class="data-cell data-cell-key">年份</div>
        <div class="data-cell data-cell-num">诉讼数</div>
        <div class="data-cell data-cell-num">被执行</div>
      </div>
      {% for b in case_buckets %}
      <div class="data-row">
        <div class="data-cell data-cell-key">{{ b.year }}</div>
        <div class="data-cell data-cell-num mono">{{ b.cases }}</div>
        <div class="data-cell data-cell-num mono">{{ b.enforcements }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if case_timeline_svg %}
    <div class="inline-viz">
      <div class="inline-viz-label">诉讼时间线</div>
      <div class="inline-viz-svg">{{ case_timeline_svg | safe }}</div>
    </div>
    {% endif %}

    {% if jf.sample_cases and jf.sample_cases|length > 0 %}
    <div class="case-list">
      {% for c in jf.sample_cases[:5] %}
      <div class="case-card">
        <div class="case-card-head">
          <span class="case-card-title">{{ c.title }}</span>
          {% if c.url %}<a class="case-card-link" href="{{ c.url }}" target="_blank" rel="noopener">查看原文 →</a>{% endif %}
        </div>
        {% if c.summary %}<div class="case-card-body">{{ c.summary }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

  {% else %}
  <div class="chapter-takeaway">
    <span class="chapter-takeaway-tag">未能取得</span>
    司法数据本次未能取得。可手动到 [裁判文书网](https://wenshu.court.gov.cn/) / [执行信息公开网](https://zxgk.court.gov.cn/) 核查。
  </div>
  {% endif %}
</section>

