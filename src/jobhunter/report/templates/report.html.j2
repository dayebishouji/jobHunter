{# ============================================================
   Side chapter — 面试准备 (流程 + 反问 + 试用期)
   ============================================================ #}
<section class="chapter chapter-side" id="ch-interview-prep">
  <header class="chapter-head">
    <div class="chapter-num chapter-num-side">面试</div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">面试准备</h2>
      <p class="chapter-dek">面试流程 + 反问清单 + 试用期观察 — 进这家公司的全流程行动指南</p>
    </div>
  </header>

  {# --- 面试流程 --- #}
  {% set rf = data.review_facts %}
  {% if rf and (rf.interview_rounds or rf.interview_style or rf.interview_difficulty or rf.interview_signals) %}
  <div class="side-section">
    <h3 class="subsection">面试流程</h3>
    <div class="data-table">
      {% if rf.interview_rounds %}
      <div class="data-row">
        <div class="data-cell data-cell-key">典型轮数</div>
        <div class="data-cell">{{ rf.interview_rounds }}</div>
      </div>
      {% endif %}
      {% if rf.interview_style %}
      <div class="data-row">
        <div class="data-cell data-cell-key">面试形式</div>
        <div class="data-cell">{{ rf.interview_style }}</div>
      </div>
      {% endif %}
      {% if rf.interview_difficulty %}
      <div class="data-row">
        <div class="data-cell data-cell-key">难度</div>
        <div class="data-cell">
          <span class="chip chip-{{ {'easy':'good','medium':'mid','hard':'bad'}.get(rf.interview_difficulty, 'unknown') }}">
            {{ {'easy':'简单','medium':'中等','hard':'较难'}.get(rf.interview_difficulty, rf.interview_difficulty) }}
          </span>
        </div>
      </div>
      {% endif %}
    </div>

    {% if rf.interview_signals %}
    <ul class="signal-list signal-list-compact">
      {% for s in rf.interview_signals[:5] %}
        {{ signal_card(s, 'interview') }}
      {% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endif %}

  {# --- 面试反问清单 --- #}
  <div class="side-section">
    <h3 class="subsection">面试反问清单</h3>
    <ol class="question-list">
      {% set qlist = data.interview_questions or [] %}
      {% for q in qlist[:10] %}
      <li class="question-item">
        <span class="question-num mono">{{ '%02d'|format(loop.index) }}</span>
        <span class="question-text">{{ q }}</span>
      </li>
      {% endfor %}
    </ol>
  </div>

  {# --- 试用期观察清单 --- #}
  {% if trial_checklist %}
    <div class="side-section">
      <h3 class="subsection">试用期观察清单</h3>
      <div class="trial-grid">
        {% set bucket_labels = {'1mo': '1 个月', '3mo': '3 个月', '6mo': '6 个月'} %}
        {% for bucket_key, bucket_items in trial_checklist.items() %}
        <div class="trial-bucket">
          <div class="trial-bucket-head">
            <span class="trial-bucket-when">{{ bucket_labels.get(bucket_key, bucket_key) }}</span>
            <span class="trial-bucket-tag">观察</span>
          </div>
          <ul class="trial-bucket-list">
            {% for item in bucket_items %}
            <li class="trial-bucket-item">{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
</section>

