<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>公司反向背调 · {{ data.query.company }}</title>
<style>{{ css | safe }}</style>
</head>
<body>
<div class="container">

  {# ---------- Hero ---------- #}
  <header class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <div class="kicker">反向背调报告</div>
        <h1>{{ data.query.company }}<span class="pill {{ data.overall_confidence }}">{{ {'high':'高置信','medium':'中等置信','low':'低置信'}[data.overall_confidence] }}</span></h1>
        <div class="meta">生成于 {{ data.generated_at.strftime('%Y-%m-%d %H:%M') }} · jobHunter v0.1</div>
        <div class="target">📍 {{ data.query.position or '岗位未指定' }} · {{ data.query.city or '城市未指定' }}</div>
      </div>
      <div class="hero-score">
        {{ hero_ring_svg | safe }}
        <div class="hero-score-label">综合健康度</div>
      </div>
    </div>
  </header>

  {# ---------- 5-axis overview: radar + axis list ---------- #}
  <section class="overview">
    <h2 class="section-h2">5 轴概览</h2>
    <div class="overview-grid">
      <div class="radar-wrap">{{ radar_svg | safe }}</div>
      <div class="axis-list">
        {% for ax in data.axes %}
        <div class="axis-row">
          <div class="axis-name">{{ ax.label_zh }}</div>
          <div class="axis-bar">
            {% for n in range(1, 6) %}
              <span class="dot {{ ax.color if n <= ax.stars else 'none' }}"></span>
            {% endfor %}
          </div>
          <div class="axis-score {{ ax.color }}">{{ ax.stars }}</div>
          <div class="axis-rationale">{{ ax.rationale }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ---------- Data gaps (if any) ---------- #}
  {% if data.data_gaps %}
  <details open>
    <summary>{{ section_icon('数据缺口') }} 数据缺口</summary>
    <div class="section-body">
      {% for g in data.data_gaps %}
      <div class="data-gap">⚠ {{ g }}</div>
      {% endfor %}
    </div>
  </details>
  {% endif %}

  {# ---------- Business basics ---------- #}
  <details>
    <summary>{{ section_icon('工商基本面') }} 工商基本面</summary>
    <div class="section-body">
      {% set b = data.business_facts %}
      {% if not b %}
        <p class="empty">未能获取工商数据。建议人工到 gsxt.gov.cn 与 启信宝/天眼查 核查"{{ data.query.company }}"的法人、注册资本、经营状态、是否经营异常。</p>
      {% else %}
        <table>
          <tr><th>法人</th><td>{{ b.legal_rep or '—' }}</td></tr>
          <tr><th>成立日期</th><td>{{ b.established_at or '—' }}</td></tr>
          <tr><th>注册资本</th><td>{{ b.registered_capital or '—' }}</td></tr>
          {% if b.paid_in_capital %}
          <tr><th>实缴资本</th><td>{{ b.paid_in_capital }}</td></tr>
          {% endif %}
          <tr><th>经营状态</th><td>{{ b.status or '—' }}</td></tr>
          {% if b.address %}<tr><th>注册地址</th><td>{{ b.address }}</td></td></tr>{% endif %}
          {% if b.scope %}<tr><th>经营范围</th><td>{{ b.scope }}</td></tr>{% endif %}
          {% if b.anomaly_listed %}
          <tr><th>经营异常</th><td style="color:var(--bad);">已列入经营异常名录</td></tr>
          {% endif %}
        </table>
        {% if b.top_shareholders %}
        <h4 style="margin-top:14px;font-size:13px;">主要股东</h4>
        <table>
          <thead><tr><th>股东</th><th>持股</th><th>出资</th></tr></thead>
          <tbody>
            {% for s in b.top_shareholders %}
            <tr>
              <td>{{ s.name }}</td>
              <td>{{ '{:.0%}'.format(s.stake_pct/100) if s.stake_pct is not none else '—' }}</td>
              <td>{{ s.contribution or '—' }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% endif %}
      {% endif %}
    </div>
  </details>

  {# ---------- Company profile (主营业务 / 产品 / 融资 / 规模) ---------- #}
  <details>
    <summary>{{ section_icon('公司画像') }} 公司画像</summary>
    <div class="section-body">
      {% set cp = data.company_profile %}
      {% if not cp %}
        <p class="empty">公司画像数据缺失。可人工到 <a href="https://baike.baidu.com/" target="_blank" rel="noopener">百度百科</a> / <a href="https://www.itjuzi.com/" target="_blank" rel="noopener">IT桔子</a> / <a href="https://www.qcc.com/" target="_blank" rel="noopener">企查查</a> 搜索 "{{ data.query.company }}" 核实主营业务、融资阶段与规模。</p>
      {% else %}
        {% if cp.description %}<p style="margin:0 0 10px 0;font-size:13px;color:var(--text);">{{ cp.description }}</p>{% endif %}
        <table>
          {% if cp.official_website %}<tr><th>官网</th><td><a href="{{ cp.official_website }}" target="_blank" rel="noopener">{{ cp.official_website }}</a></td></tr>{% endif %}
          {% if cp.headquarters %}<tr><th>总部</th><td>{{ cp.headquarters }}</td></tr>{% endif %}
          {% if cp.founded_year %}<tr><th>成立年份</th><td>{{ cp.founded_year }}</td></tr>{% endif %}
          {% if cp.company_size %}<tr><th>公司规模</th><td>{{ cp.company_size }}</td></tr>{% endif %}
          {% if cp.funding_stage %}<tr><th>融资阶段</th><td>{{ cp.funding_stage }}{% if cp.total_funding %} · 累计 {{ cp.total_funding }}{% endif %}</td></tr>{% endif %}
        </table>
        {% if cp.main_business %}
        <h4 style="margin-top:14px;font-size:13px;">主营业务</h4>
        <ul class="bullets">
          {% for m in cp.main_business %}<li>{{ m }}</li>{% endfor %}
        </ul>
        {% endif %}
        {% if cp.products %}
        <h4 style="margin-top:14px;font-size:13px;">主要产品 / 产品线</h4>
        <ul class="bullets">
          {% for p in cp.products %}<li>{{ p }}</li>{% endfor %}
        </ul>
        {% endif %}
        {% if cp.industries %}
        <h4 style="margin-top:14px;font-size:13px;">所属行业</h4>
        <div>{% for ind in cp.industries %}<span class="chip" style="margin-right:6px;">{{ ind }}</span>{% endfor %}</div>
        {% endif %}
        {% if cp.investors %}
        <h4 style="margin-top:14px;font-size:13px;">主要投资方</h4>
        <div>{% for inv in cp.investors %}<span class="chip" style="margin-right:6px;">{{ inv }}</span>{% endfor %}</div>
        {% endif %}
        {% if cp.prospects %}
        <h4 style="margin-top:14px;font-size:13px;">发展前景</h4>
        <p style="font-size:13px;color:var(--text);">{{ cp.prospects }}</p>
        {% endif %}
      {% endif %}
    </div>
  </details>

  {# ---------- Judicial risk ---------- #}
  <details>
    <summary>{{ section_icon('司法风险') }} 司法风险</summary>
    <div class="section-body">
      {% set j = data.judicial_facts %}
      {% if not j %}
        <p class="empty">司法数据源在本次抓取中未能取得。建议人工到 <a href="https://wenshu.court.gov.cn/" target="_blank" rel="noopener">wenshu.court.gov.cn</a> 和 <a href="https://zxgk.court.gov.cn/" target="_blank" rel="noopener">zxgk.court.gov.cn</a> 核查「{{ data.query.company }}」涉诉与被执行记录。</p>
      {% else %}
        <table>
          <tr><th>累计案件数</th><td>{{ j.case_count_total or '—' }}</td></tr>
          <tr><th>近一年案件数</th><td>{{ j.case_count_recent_year or '—' }}</td></tr>
          <tr><th>被执行记录</th><td>{{ j.enforcement_records or 0 }} 条</td></tr>
        </table>
        {% if j.sample_cases %}
        <h4 style="margin-top:14px;font-size:13px;">样本案件</h4>
        <ul class="bullets">
          {% for c in j.sample_cases %}
          <li>
            <strong>{{ c.title }}</strong> · {{ c.role }}{% if c.year %} · {{ c.year }}{% endif %}
            {% if c.url %} · <a href="{{ c.url }}" target="_blank" rel="noopener">链接</a>{% endif %}
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      {% endif %}
    </div>
  </details>

  {# ---------- Salary & benefits ---------- #}
  <details>
    <summary>{{ section_icon('薪酬与福利') }} 薪酬与福利</summary>
    <div class="section-body">
      {% set r = data.review_facts %}
      {% if not r or not r.salary_signals %}
        <p class="empty">暂无薪酬爆料。可在看准网 / 脉脉 / 牛客 / 一亩三分地 搜索 "{{ data.query.company }}"。</p>
      {% else %}
        <table>
          <thead><tr><th>岗位</th><th>月base (K)</th><th>奖金 (月)</th><th>证据</th><th>来源</th></tr></thead>
          <tbody>
            {% for s in r.salary_signals %}
            <tr>
              <td>{{ s.position or '—' }}</td>
              <td>{{ '%.1f'|format(s.base_monthly_k) if s.base_monthly_k is not none else '—' }}</td>
              <td>{{ s.bonus_months if s.bonus_months is not none else '—' }}</td>
              <td style="font-size:12px;color:var(--muted);">{{ s.evidence }}</td>
              <td>{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">链接</a>{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>

        {% if salary_dist %}
        <h4 style="margin-top:14px;font-size:13px;">月薪分布（K）</h4>
        <div class="bar-chart bar-chart-vertical">
          {% set max_count = (salary_dist | map(attribute='count') | max) %}
          {% for b in salary_dist %}
          <div class="vbar">
            <div class="vbar-fill" style="height:{% if max_count > 0 %}{{ (b.count / max_count * 100)|int }}{% else %}0{% endif %}%;"></div>
            <div class="vbar-count">{{ b.count }}</div>
            <div class="vbar-label">{{ b.label }}</div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      {% endif %}
    </div>
  </details>

  {# ---------- Overtime & work intensity ---------- #}
  <details>
    <summary>{{ section_icon('加班与工作强度') }} 加班与工作强度</summary>
    <div class="section-body">
      {% set r = data.review_facts %}
      {% if not r or not r.overtime_signals %}
        <p class="empty">暂无加班节奏信号。</p>
      {% else %}
        {% if overtime_dist %}
        <h4 style="margin-top:4px;font-size:13px;">节奏模式分布</h4>
        <div class="bar-chart bar-chart-horizontal">
          {% set max_count = (overtime_dist | map(attribute='count') | max) %}
          {% for o in overtime_dist %}
          <div class="hbar">
            <div class="hbar-label">{{ o.pattern }}</div>
            <div class="hbar-track">
              <div class="hbar-fill intensity-{{ o.intensity }}" style="width:{% if max_count > 0 %}{{ (o.count / max_count * 100)|int }}{% else %}0{% endif %}%;"></div>
            </div>
            <div class="hbar-count">{{ o.count }}<span class="hbar-pct"> · {{ o.pct }}%</span></div>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        <h4 style="margin-top:14px;font-size:13px;">原始爆料</h4>
        <ul class="bullets">
          {% for o in r.overtime_signals %}
          <li>
            <span class="chip chip-{{ {'high':'bad','medium':'warn','low':'good'}[o.intensity] }}">{{ o.pattern }} · {{ {'high':'重','medium':'中','low':'轻'}[o.intensity] }}</span>
            {% if o.url %} · <a href="{{ o.url }}" target="_blank" rel="noopener">来源</a>{% endif %}
            {% if o.evidence %}
              <blockquote class="evidence">"{{ o.evidence }}"</blockquote>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </details>

  {# ---------- Team vibe ---------- #}
  <details>
    <summary>{{ section_icon('团队氛围与文化') }} 团队氛围与文化</summary>
    <div class="section-body">
      {% set r = data.review_facts %}
      {% if not r or not r.vibe_signals %}
        <p class="empty">暂无直接氛围信号。</p>
      {% else %}
        <ul class="bullets">
          {% for v in r.vibe_signals %}
          <li>
            <span class="chip chip-{{ {'positive':'good','negative':'bad','mixed':'warn'}.get(v.sentiment, 'warn') }}">{{ {'positive':'正面','negative':'负面','mixed':'混合','neutral':'中性'}[v.sentiment] }}</span>
            {% if v.url %} · <a href="{{ v.url }}" target="_blank" rel="noopener">来源</a>{% endif %}
            {% if v.evidence %}
              <blockquote class="evidence">"{{ v.evidence }}"</blockquote>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </details>

  {# ---------- JD vs reality ---------- #}
  {% set r = data.review_facts %}
  {% if r and r.jd_gap_signals %}
  <details>
    <summary>{{ section_icon('岗位真实情况 vs 招聘 JD') }} 岗位真实情况 vs 招聘 JD</summary>
    <div class="section-body">
      <ul class="bullets">
        {% for j in r.jd_gap_signals %}
        <li>
          <div><strong>JD 承诺：</strong>{{ j.jd_promise }}</div>
          <div><strong>实际：</strong>{{ j.reality }}</div>
          {% if j.url %} · <a href="{{ j.url }}" target="_blank" rel="noopener">来源</a>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </details>
  {% endif %}

  {# ---------- Recent news ---------- #}
  <details>
    <summary>{{ section_icon('近期舆情') }} 近期舆情</summary>
    <div class="section-body">
      {% set n = data.news_facts %}
      {% if not n or not n.items %}
        <p class="empty">暂无近期舆情。</p>
      {% else %}
        <p style="font-size:13px;color:var(--muted);">整体情感倾向：<strong>{{ {'positive':'偏正面','negative':'偏负面','mixed':'混合','neutral':'中性'}[n.sentiment] }}</strong></p>
        <ul class="bullets">
          {% for it in n.items %}
          <li>
            <strong>{{ it.title }}</strong>
            {% if it.published_at %} · <span style="color:var(--muted);font-size:12px;">{{ it.published_at }}</span>{% endif %}
            {% if it.url %} · <a href="{{ it.url }}" target="_blank" rel="noopener">链接</a>{% endif %}
            {% if it.summary %}<blockquote class="evidence">"{{ it.summary }}"</blockquote>{% endif %}
          </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </details>

  {# ---------- Interview questions ---------- #}
  {% if data.interview_questions %}
  <details open>
    <summary>{{ section_icon('面试反问清单') }} 面试反问清单</summary>
    <div class="section-body">
      {% for q in data.interview_questions %}
      <div class="interview-q">{{ q }}</div>
      {% endfor %}
    </div>
  </details>
  {% endif %}

  {# ---------- LLM inferences ---------- #}
  {% if data.findings and data.findings.inferences %}
  <details>
    <summary>{{ section_icon('综合推断（LLM 推断，每条带佐证）') }} 综合推断（LLM 推断，每条带佐证）</summary>
    <div class="section-body">
      <ul class="bullets">
        {% for inf in data.findings.inferences %}
        <li>
          {{ inf.claim }}
          {% if inf.grounding_evidence %}<a class="inferred-mark" href="{{ inf.grounding_evidence[0] }}" target="_blank" rel="noopener">佐证</a>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </details>
  {% endif %}

  {# ---------- Sources appendix ---------- #}
  <details>
    <summary>{{ section_icon('数据来源附录') }} 数据来源附录（{{ sources|length }} 条）</summary>
    <div class="section-body">
      {% if not sources %}
        <p class="empty">暂无来源链接。</p>
      {% else %}
      <ul class="sources-list">
        {% for s in sources %}
        <li>
          <img class="favicon" src="{{ favicon_url(s.domain) }}" alt="" loading="lazy"
               onerror="this.style.visibility='hidden'" />
          <span class="domain">{{ s.domain }}</span>
          {% if s.title %}<strong>{{ s.title }}</strong> · {% endif %}
          <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.url }}</a>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </details>

  <footer class="footnote">
    本报告由 jobHunter 自动生成，仅供个人求职参考。请独立判断并自行核实关键事实。
  </footer>
</div>
</body>
</html>