  {{ story_block('news') }}

  {% set nf = data.news_facts %}
  {% if nf and nf.items and nf.items|length > 0 %}
  <div class="chapter-takeaway">
    <span class="chapter-takeaway-tag">一句话</span>
    本章汇总 {{ nf.items|length }} 条近期新闻信号 · 整体情感
    {% if nf.sentiment == 'positive' %}偏正面
    {% elif nf.sentiment == 'negative' %}偏负面
    {% else %}中性
    {% endif %}
