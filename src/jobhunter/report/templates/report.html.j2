<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>反向背调 · {{ data.query.company }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

{# === Macro: render per-chapter confidence badge near chapter title === #}
{% macro conf_badge(chapter_key) -%}
  {% set c = data.chapter_confidence.get(chapter_key) %}
  {% if c and confidence_label and c != 'high' %}
    {% set label, cls = confidence_label.get(c, (c, 'conf-low')) %}
    <span class="conf-badge {{ cls }}" title="该章数据置信度（高=原始材料+结构化信号均有；中=两者之一；低=缺）">{{ label }}</span>
  {% endif %}
{%- endmacro %}

{# === Macro: v0.1.13 — 编辑手记 aside + 数据故事 lines ===
   Renders a single block per chapter showing:
   - <aside class="edit-note">…</aside> if edit_notes has this chapter
   - <ul class="data-story">…</ul> if data_stories has this chapter
   Both are pure deterministic content from builder.compute_chapter_stories(). #}
{% macro story_block(chapter_key) -%}
  {% set en = edit_notes.get(chapter_key) %}
  {% set ds = data_stories.get(chapter_key) %}
  {% if en or ds %}
  <aside class="story-block" aria-label="编辑手记与数据故事">
    {% if en %}
    <div class="edit-note">
      <span class="edit-note-tag">编辑手记</span>
      <span class="edit-note-body">{{ en }}</span>
    </div>
    {% endif %}
    {% if ds and ds|length > 0 %}
    <ul class="data-story">
      {% for line in ds %}
      <li class="data-story-line">{{ line }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </aside>
  {% endif %}
{%- endmacro %}
<link rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;700&display=swap" />
<style>{{ css | safe }}</style>
</head>
<body>
<div class="container">

{# ---------- Masthead ---------- #}
<header class="masthead">
  <div class="masthead-left">jobHunter · 反向背调</div>
  <div class="masthead-title">公司备忘录</div>
  <div class="masthead-right">
    <span class="mono">{{ data.generated_at.strftime('%Y-%m-%d') }}</span> · 第 {{ now.strftime('%V') }} 周
  </div>
</header>

{# ---------- Hero ---------- #}
<section class="hero">
  <div class="hero-main">
    <div class="hero-edition">{{ data.query.position or '岗位未指定' }} · {{ data.query.city or '城市未指定' }}</div>
    <h1 class="hero-title">
      {{ data.query.company }}
      <span class="target">一份关于 {{ data.query.company }} 的尽调备忘</span>
    </h1>
    <div class="hero-meta">
      <span><span class="meta-key">置信度</span>
        <span class="pill {{ data.overall_confidence }}">
          {{ {'high':'高置信','medium':'中等置信','low':'低置信'}[data.overall_confidence] }}
        </span>
      </span>
      <span><span class="meta-key">综合分</span>
        <span class="meta-val mono">{{ '%.1f'|format(avg_score) }} / 5.0</span>
      </span>
      <span><span class="meta-key">数据维度</span>
        <span class="meta-val mono">
          {{ (1 if data.company_profile else 0) + (1 if data.business_facts else 0) + (1 if data.review_facts else 0) + (1 if data.news_facts else 0) + (1 if data.judicial_facts else 0) }}/5
        </span>
      </span>
      <span><span class="meta-key">来源</span>
        <span class="meta-val mono">{{ sources|length }} 条</span>
      </span>
      <span><span class="meta-key">数据多样性</span>
        {% set dk = diversity_kpi %}
        <span class="pill {{ 'high' if dk.tier_label_zh == '高' else ('medium' if dk.tier_label_zh == '中' else 'low') }}" title="{{ dk.corroborated_count }} 条多源印证 / {{ dk.distinct_domains|length }} 个独立域 / {{ dk.total_signals }} 条 signal">
          {{ dk.tier_label_zh }} · {{ dk.corroborated_count }}/{{ dk.total_signals }} 印证
        </span>
      </span>
    </div>

    {% set cp = data.company_profile %}
    {% if cp and cp.description %}
      <p class="hero-summary">
        {{ cp.description }}
        {% if cp.headquarters or cp.company_size or cp.funding_stage %}
          <strong>
            {%- if cp.headquarters %}总部位于 {{ cp.headquarters }}{% endif -%}
            {%- if cp.company_size %} · {{ cp.company_size }}{% endif -%}
            {%- if cp.funding_stage %} · {{ cp.funding_stage }}{% endif -%}
            {%- if cp.founded_year %} · 成立 {{ cp.founded_year }}{% endif -%}
          </strong>
        {% endif %}
      </p>
    {% endif %}
  </div>

  <aside class="hero-side">
    <div class="hero-ring">
      <div class="hero-ring-label">综合健康度</div>
      {{ hero_ring_svg | safe }}
    </div>

    {% set lowest = (data.axes | sort(attribute='stars'))[0] if data.axes else None %}
    {% if lowest %}
      <div class="hero-dispatch">
        <span class="dispatch-label">主编按</span>
        最弱维度是 <strong>{{ lowest.label_zh }}</strong> ({{ lowest.stars }}/5)——{{ lowest.rationale }}
      </div>
    {% endif %}

    {% if data.axes %}
    <div class="hero-radar">
      <div class="hero-ring-label">风险断面</div>
      <div class="hero-radar-svg">{{ radar_svg | safe }}</div>
    </div>
    {% endif %}
  </aside>
</section>

{# ---------- 5-axis ribbon ---------- #}
{% if data.axes %}
<section class="axis-ribbon">
  {% for ax in data.axes %}
  <div class="axis-ribbon-cell" data-color="{{ ax.color }}">
    <div class="axis-ribbon-name">{{ ax.label_zh }}</div>
    <div class="axis-ribbon-num">{{ ax.stars }}<span style="font-size:0.55em;color:var(--ink-soft);">/5</span></div>
    <div class="axis-ribbon-bar">
      {% for n in range(1, 6) %}
        <span class="axis-ribbon-dot {{ 'on' if n <= ax.stars else '' }}" data-color="{{ ax.color }}"></span>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</section>
{% endif %}

{# ====================== CHAPTER I — 公司画像 ====================== #}
<div class="chapters-container" id="chapters-container">
<button type="button" class="reorder-reset" id="reorder-reset" hidden title="恢复默认章节顺序">↺ 重置章节顺序</button>

<section class="chapter" id="ch-company" draggable="true" data-chapter-key="company">
  <header class="chapter-head">
    <div class="chapter-num"><span class="drag-handle" aria-label="拖动以重排章节" title="拖动以重排章节">⋮⋮</span>I<span class="slash">/</span><span class="total">VI</span></div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">公司画像 {{ conf_badge('company') }}</h2>
      <p class="chapter-dek">主营业务、产品矩阵、融资轨迹与前景——读懂这家公司是谁</p>
    </div>
  </header>
  {{ story_block('company') }}

  {% set cp = data.company_profile %}
  {% if not cp %}
    <p class="empty">公司画像数据缺失。可人工到 <a href="https://baike.baidu.com/" target="_blank" rel="noopener">百度百科</a> / <a href="https://www.itjuzi.com/" target="_blank" rel="noopener">IT 桔子</a> / <a href="https://www.qcc.com/" target="_blank" rel="noopener">企查查</a> 搜索 "{{ data.query.company }}" 核实主营业务、融资阶段与规模。</p>
  {% else %}

  {% if cp.prospects %}
  <div class="chapter-takeaway">
    <div class="chapter-takeaway-tag">一句话结论</div>
    <div>{{ cp.prospects }}</div>
  </div>
  {% endif %}

  {# Stat strip — the at-a-glance facts #}
  <div class="stat-strip">
    {% if cp.official_website %}
    <div class="stat">
      <div class="stat-key">官网</div>
      <div class="stat-val" style="font-size:16px;"><a href="{{ cp.official_website }}" target="_blank" rel="noopener">{{ cp.official_website.host }}</a></div>
    </div>
    {% endif %}
    {% if cp.headquarters %}
    <div class="stat">
      <div class="stat-key">总部</div>
      <div class="stat-val" style="font-size:18px;">{{ cp.headquarters }}</div>
    </div>
    {% endif %}
    {% if cp.founded_year %}
    <div class="stat">
      <div class="stat-key">成立</div>
      <div class="stat-val">{{ cp.founded_year }}<span class="unit">年</span></div>
    </div>
    {% endif %}
    {% if cp.company_size %}
    <div class="stat">
      <div class="stat-key">规模</div>
      <div class="stat-val" style="font-size:18px;">{{ cp.company_size }}</div>
    </div>
    {% endif %}
    {% if cp.funding_stage %}
    <div class="stat">
      <div class="stat-key">融资</div>
      <div class="stat-val" style="font-size:18px;">{{ cp.funding_stage }}</div>
    </div>
    {% endif %}
    {% if cp.total_funding %}
    <div class="stat">
      <div class="stat-key">累计</div>
      <div class="stat-val" style="font-size:18px;">{{ cp.total_funding }}</div>
    </div>
    {% endif %}
  </div>

  <div class="chapter-grid">
    <div>
      <h3 class="serif" style="font-size:20px;margin:18px 0 8px;">主营业务</h3>
      {% if cp.main_business %}
        <ul class="bullets">
          {% for m in cp.main_business %}<li>{{ m }}</li>{% endfor %}
        </ul>
      {% else %}
        <p class="empty">主营业务未披露。</p>
      {% endif %}

      <h3 class="serif" style="font-size:20px;margin:24px 0 8px;">主要产品</h3>
      {% if cp.products %}
        <ul class="bullets">
          {% for p in cp.products %}<li>{{ p }}</li>{% endfor %}
        </ul>
      {% else %}
        <p class="empty">产品线未披露。</p>
      {% endif %}

      {% if cp.industries %}
      <h3 class="serif" style="font-size:20px;margin:24px 0 8px;">所属行业</h3>
      <div>{% for ind in cp.industries %}<span class="chip chip-neutral" style="margin-right:6px;">{{ ind }}</span>{% endfor %}</div>
      {% endif %}

      {% if cp.investors %}
      <h3 class="serif" style="font-size:20px;margin:24px 0 8px;">主要投资方</h3>
      <div>{% for inv in cp.investors %}<span class="chip" style="margin-right:6px;color:var(--accent);border-color:var(--accent);">{{ inv }}</span>{% endfor %}</div>
      {% endif %}
    </div>

    <aside>
      <div class="sidebar">
        <div class="sidebar-label">融资阶梯</div>
        <div class="ladder">
          {% for i in range(6) %}
            <div class="ladder-step {{ 'current' if funding_stage_pos == i else '' }}">
              <div class="ladder-step-current"></div>
              <div class="ladder-step-name">
                {% if i == 0 %}未融资
                {% elif i == 1 %}天使
                {% elif i == 2 %}A 轮
                {% elif i == 3 %}B 轮
                {% elif i == 4 %}C 及以上
                {% elif i == 5 %}已上市
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        <p style="margin:8px 0 0;font-size:12px;color:var(--ink-soft);line-height:1.5;">
          {% if cp.funding_stage %}
            当前所处阶段: <strong style="color:var(--accent);">{{ cp.funding_stage }}</strong>
            {% if cp.total_funding %} · 累计融资 {{ cp.total_funding }}{% endif %}
          {% else %}
            融资信息未披露
          {% endif %}
        </p>
      </div>

      {% if cp.description %}
      <div class="sidebar">
        <div class="sidebar-label">公司简介</div>
        <p class="sidebar-quote">
          {{ cp.description }}
        </p>
      </div>
      {% endif %}
    </aside>
  </div>

  {% if cp.source_urls %}
  <p style="margin-top:14px;font-size:11.5px;color:var(--ink-faint);">
    来源 · {% for url in cp.source_urls[:5] %}<a href="{{ url }}" target="_blank" rel="noopener" style="margin-right:10px;">{{ url.host }}</a>{% endfor %}
  </p>
  {% endif %}
  {% endif %}
</section>

{# ====================== CHAPTER II — 工商基本面 ====================== #}
<section class="chapter" id="ch-business" draggable="true" data-chapter-key="business">
  <header class="chapter-head">
    <div class="chapter-num"><span class="drag-handle" aria-label="拖动以重排章节" title="拖动以重排章节">⋮⋮</span>II<span class="slash">/</span><span class="total">VI</span></div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">工商基本面 {{ conf_badge('business') }}</h2>
      <p class="chapter-dek">法人、注册资本、经营状态、股权结构——法律登记视角</p>
    </div>
  </header>
  {{ story_block('business') }}

  {% set b = data.business_facts %}
  {% if not b %}
    <p class="empty">未能获取工商数据。建议人工到 <a href="https://www.gsxt.gov.cn/" target="_blank" rel="noopener">gsxt.gov.cn</a> 与 <a href="https://www.qcc.com/" target="_blank" rel="noopener">企查查</a> 核查 "{{ data.query.company }}" 的法人、注册资本、经营状态、是否经营异常。</p>
  {% else %}
  <div class="stat-strip">
    <div class="stat"><div class="stat-key">法人</div><div class="stat-val" style="font-size:18px;">{{ b.legal_rep or '—' }}</div></div>
    <div class="stat"><div class="stat-key">成立</div><div class="stat-val">{{ b.established_at or '—' }}</div></div>
    <div class="stat"><div class="stat-key">注册资本</div><div class="stat-val" style="font-size:18px;">{{ b.registered_capital or '—' }}</div></div>
    <div class="stat"><div class="stat-key">实缴</div><div class="stat-val" style="font-size:18px;">{{ b.paid_in_capital or '—' }}</div></div>
    <div class="stat"><div class="stat-key">状态</div><div class="stat-val {{ 'good' if b.status == '存续' else ('bad' if b.status in ('注销','吊销','迁出') else '') }}" style="font-size:18px;">{{ b.status or '—' }}</div></div>
  </div>

  <div class="chapter-grid flip">
    <aside>
      {% if b.top_shareholders %}
      <div class="sidebar">
        <div class="sidebar-label">股东持股</div>
        {{ shareholder_donut_svg | safe }}
        <div class="donut-legend">
          {% set palette_names = ['暗酒红','焦糖','驼色','浅棕','米灰'] %}
          {% for s in b.top_shareholders[:5] %}
          <div class="donut-legend-row">
            <span class="donut-legend-swatch" style="background: {% if loop.index0 == 0 %}var(--accent){% elif loop.index0 == 1 %}var(--accent-2){% elif loop.index0 == 2 %}var(--caramel){% else %}var(--ink-soft){% endif %};"></span>
            <span class="donut-legend-label">{{ s.name }}</span>
            <span class="donut-legend-val">{{ '{:.0%}'.format(s.stake_pct/100) if s.stake_pct is not none else '—' }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </aside>

    <div>
      <table>
        {% if b.address %}<tr><th style="width:110px;">注册地址</th><td>{{ b.address }}</td></tr>{% endif %}
        {% if b.scope %}<tr><th>经营范围</th><td>{{ b.scope }}</td></tr>{% endif %}
        {% if b.anomaly_listed %}
        <tr><th>经营异常</th><td style="color:var(--risk-bad);font-weight:600;">已列入经营异常名录</td></tr>
        {% endif %}
        {% if b.external_investments_count is not none %}
        <tr><th>对外投资</th><td>{{ b.external_investments_count }} 家</td></tr>
        {% endif %}
      </table>
    </div>
  </div>
  {% endif %}
</section>

{# ====================== CHAPTER III — 司法风险 ====================== #}
<section class="chapter" id="ch-judicial" draggable="true" data-chapter-key="judicial">
  <header class="chapter-head">
    <div class="chapter-num"><span class="drag-handle" aria-label="拖动以重排章节" title="拖动以重排章节">⋮⋮</span>III<span class="slash">/</span><span class="total">VI</span></div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">司法风险 {{ conf_badge('judicial') }}</h2>
      <p class="chapter-dek">诉讼、被执行——是历史欠账还是经营常态</p>
    </div>
  </header>
  {{ story_block('judicial') }}

  {% set j = data.judicial_facts %}
  {% set j_zero = (j is not none) and ((j.case_count_total or 0) + (j.enforcement_records or 0)) == 0 %}
  {% if not j %}
    {# v0.1.14 — Judicial data not fetched (gsxt/wenshu soft-fail) is honest,
       but we still frame it as a manual-check action rather than dead air. #}
    <div class="chapter-takeaway" style="border-left:3px solid var(--risk-mid);">
      <div class="chapter-takeaway-tag">未能取得司法数据</div>
      <div>公开裁判文书网在本次抓取中未命中。建议人工到 <a href="https://wenshu.court.gov.cn/" target="_blank" rel="noopener">wenshu.court.gov.cn</a> 和 <a href="https://zxgk.court.gov.cn/" target="_blank" rel="noopener">zxgk.court.gov.cn</a> 核查「{{ data.query.company }}」涉诉与被执行记录。</div>
    </div>
  {% elif j_zero %}
    {# v0.1.14 — Zero-record case is actually a positive signal. Reframe. #}
    <div class="chapter-takeaway" style="border-left:3px solid var(--risk-good);">
      <div class="chapter-takeaway-tag">公开记录中未发现诉讼或被执行</div>
      <div>本次抓取范围内（裁判文书网 / 中国执行信息公开网 / 天眼查 / 企查查）没有命中「{{ data.query.company }}」的诉讼或被执行记录 —— 这通常是同行里相对少见的干净背景。建议正式入职前再人工核查一次（裁判文书网偶有收录延迟）。</div>
    </div>
  {% else %}
  <div class="stat-strip">
    <div class="stat"><div class="stat-key">累计案件</div><div class="stat-val {{ 'bad' if (j.case_count_total or 0) > 50 else ('mid' if (j.case_count_total or 0) > 10 else 'good') }}">{{ j.case_count_total if j.case_count_total is not none else '—' }}</div></div>
    <div class="stat"><div class="stat-key">近一年</div><div class="stat-val {{ 'bad' if (j.case_count_recent_year or 0) > 10 else ('mid' if (j.case_count_recent_year or 0) > 3 else 'good') }}">{{ j.case_count_recent_year if j.case_count_recent_year is not none else '—' }}</div></div>
    <div class="stat"><div class="stat-key">被执行</div><div class="stat-val {{ 'bad' if (j.enforcement_records or 0) > 0 else 'good' }}">{{ j.enforcement_records or 0 }}<span class="unit">条</span></div></div>
  </div>

  {% if j.sample_cases %}
  <h3 class="serif" style="font-size:20px;margin:24px 0 10px;">近 6 年案件分布</h3>
  {{ case_timeline_svg | safe }}

  <h3 class="serif" style="font-size:20px;margin:24px 0 10px;">样本案件</h3>
  <ol class="bullets">
    {% for c in j.sample_cases[:8] %}
    <li>
      <strong>{{ c.title }}</strong> · {{ c.role }}
      {% if c.year %} · <span class="mono" style="color:var(--ink-soft);font-size:12px;">{{ c.year }} 年</span>{% endif %}
      {% if c.url %} · <a href="{{ c.url }}" target="_blank" rel="noopener">来源</a>{% endif %}
    </li>
    {% endfor %}
  </ol>
  {% endif %}
  {% endif %}
</section>

{# ====================== CHAPTER IV — 薪酬与福利 ====================== #}
<section class="chapter" id="ch-salary" draggable="true" data-chapter-key="reviews">
  <header class="chapter-head">
    <div class="chapter-num"><span class="drag-handle" aria-label="拖动以重排章节" title="拖动以重排章节">⋮⋮</span>IV<span class="slash">/</span><span class="total">VI</span></div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">薪酬与福利 {{ conf_badge('reviews') }}</h2>
      <p class="chapter-dek">base / 月数 / 奖金——钱给得如何,数字说了算</p>
    </div>
  </header>
  {{ story_block('reviews') }}

  {% set r = data.review_facts %}
  {% if not r or not r.salary_signals %}
    <p class="empty">暂无薪酬爆料。可在看准网 / 脉脉 / 牛客 / 一亩三分地 / 小红书 搜索 "{{ data.query.company }}"。</p>
  {% else %}
  <table>
    <thead><tr><th>岗位</th><th>月 base (K)</th><th>奖金 (月)</th><th>证据</th><th>印证</th><th>来源</th></tr></thead>
    <tbody>
      {% for s in r.salary_signals %}
      <tr>
        <td><strong>{{ s.position or '—' }}</strong></td>
        <td class="mono">
          {%- if s.salary_range_min_k is not none and s.salary_range_max_k is not none -%}
            {{ '%.0f–%.0f'|format(s.salary_range_min_k, s.salary_range_max_k) }}
            <span class="muted" style="font-size:11px;">({{ '%.0f'|format((s.salary_range_min_k + s.salary_range_max_k) / 2) }} 中位)</span>
          {%- elif s.base_monthly_k is not none -%}
            {{ '%.1f'|format(s.base_monthly_k) }}
          {%- else -%}
            —
          {%- endif -%}
        </td>
        <td class="mono">{{ s.bonus_months if s.bonus_months is not none else '—' }}</td>
        <td><span class="muted">{{ s.evidence or '—' }}</span></td>
        {% set sup = signal_supports.get(s.url|string, {}) %}
        {% set tier = sup.get('support_tier', 'unverified') %}
        {% set tlabel = tier_label[tier][0] %}
        {% set tclass = tier_label[tier][1] %}
        <td><span class="tier-badge {{ tclass }}" title="{{ sup.get('support_count', 0) }} 个来源 / {{ sup.get('domains', [])|join(' · ') }}">{{ tlabel }}{% if sup.get('support_count', 0) > 1 %} ×{{ sup.support_count }}{% endif %}</span></td>
        <td>{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">来源</a>{% else %}—{% endif %}</td>
