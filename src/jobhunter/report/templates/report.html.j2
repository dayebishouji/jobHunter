  {% if news_timeline_svg %}
  <div class="inline-viz">
    <div class="inline-viz-label">舆情时间线</div>
    <div class="inline-viz-svg">{{ news_timeline_svg | safe }}</div>
  </div>
  {% endif %}

  <ul class="news-list">
    {% for it in nf.items[:12] %}
    <li class="news-item news-sentiment-{{ it.sentiment or 'neutral' }}">
