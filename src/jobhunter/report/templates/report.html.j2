<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>尽调备忘 · {{ data.query.company }}</title>
<meta name="description" content="jobHunter 反向背调报告 — {{ data.query.company }} · {{ data.query.position or '' }} · {{ data.query.city or '' }}" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Sans+Mono:wght@400;500;700&display=swap" />
<style>{{ css | safe }}</style>
</head>
<body>

{# ============================================================
   THESIS: 把尽调备忘录做成中文金融圈的「深度研报 + 招股书」混搭 — 严肃、可信、决断。
   读者一眼看到 5 轴雷达 + 司法干净 + 薪酬 band 这种券商口径的尽调语言,
   把"个人反向背调"从笔记升格为个人尽调备忘录。

   OWN-WORLD: paper-cream #fbfaf6 底, ink #1a1a1a 正文, broker-blue #1a3a6e brand accent;
   status colors 深绿 #2e7d32 / 朱红 #c62828 / 琥珀 #b8854a;
   Noto Serif SC (display+body), Noto Sans SC (UI labels), Noto Sans Mono (data values);
   masthead with 报告编号 / 评级 badge / 日期;
   numbered chapters (I-VII) with section-break rules;
   data tables with right-aligned numbers and ¥ prefix;
   投资要点 numbered list + 风险提示 disclaimer footer + Σ 来源附录.

   STORY: 90 秒读到 5 轴雷达 + 顶层 verdict + 3-5 行投资要点 — 一眼判生死;
   5 分钟读到司法 / 薪酬 / 加班 / 氛围 / 舆情 / 面试 全部信号密度;
   1 个月内带着 1mo / 3mo / 6mo 试用期观察清单做 action。

   FIRST VIEWPORT: 顶部 masthead (jobHunter RESEARCH · 报告 № · 标的 · 评级 · 日期);
   主体 投资要点 3-5 行 + 主编按编辑按;
   中段 3 栏 KPI grid (综合分 / 司法 / 加班);
   5 轴雷达 + 薪酬 band + 数据源 chip 墙 (本报告综合了 X 条信号 / Y 个平台).

   FORM: 券商深度研报 + 招股书 hybrid, 视觉种子 broker-research-prospectus-v1, skill impeccable.

   FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
   ============================================================ #}

<div class="page">

{# ============================================================
   MACROS
   ============================================================ #}

{# --- Confidence badge near chapter title --- #}
{% macro conf_badge(chapter_key) -%}
  {% set c = data.chapter_confidence.get(chapter_key) %}
  {% if c and confidence_label and c != 'high' %}
    {% set label, cls = confidence_label.get(c, (c, 'conf-low')) %}
    <span class="conf-badge {{ cls }}" title="该章数据置信度（高=原始材料+结构化信号均有；中=两者之一；低=缺）">{{ label }}</span>
  {% endif %}
{%- endmacro %}

{# --- Per-chapter editorial aside (编辑手记 + 数据故事) --- #}
{% macro story_block(chapter_key) -%}
  {% set en = edit_notes.get(chapter_key) %}
  {% set ds = data_stories.get(chapter_key) %}
  {% if en or ds %}
  <aside class="story-block" aria-label="编辑手记与数据故事">
    {% if en %}
    <div class="edit-note">
      <span class="edit-note-tag">编按</span>
      <span class="edit-note-body">{{ en }}</span>
    </div>
    {% endif %}
    {% if ds and ds|length > 0 %}
    <ul class="data-story">
      {% for line in ds %}
      <li class="data-story-line">{{ line }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </aside>
  {% endif %}
{%- endmacro %}

{# --- Per-signal age badge --- #}
{% macro signal_age_badge(s) -%}
  {% if s and s.published_at %}
    {% set today = data.generated_at.date() if data.generated_at and data.generated_at.date is defined else data.now_date %}
    {% set age_days = (today - s.published_at).days %}
    {% if age_days < 0 %}{% set age_days = 0 %}{% endif %}
    {% if age_days < 31 %}
      <span class="signal-age signal-age-fresh" title="信号发布时间 {{ s.published_at.isoformat() }}">{{ age_days }} 天前</span>
    {% elif age_days < 365 %}
      {% set months = (age_days / 30) | round(0, 'floor') | int %}
      <span class="signal-age signal-age-mid" title="信号发布时间 {{ s.published_at.isoformat() }}">{{ months }} 个月前</span>
    {% else %}
      {% set years = (age_days / 365) | round(1) %}
      <span class="signal-age signal-age-stale" title="信号发布时间 {{ s.published_at.isoformat() }}">{{ years }} 年前</span>
    {% endif %}
  {% endif %}
{%- endmacro %}

{# --- Per-signal evidence card with full metadata (source + age + tier) --- #}
{% macro signal_card(s, kind) -%}
  {% set url_str = s.url|string if s.url else '' %}
  {% set support = signal_supports.get(url_str) if signal_supports else None %}
  {% set tier = support.support_tier if support else 'unverified' %}
  {% set tier_pair = tier_label.get(tier, (tier, 'tier-unverified')) %}
  {% set tier_zh = tier_pair[0] %}
  {% set tier_cls = tier_pair[1] %}
  <li class="signal-card signal-card-{{ kind }}" data-tier="{{ tier }}">
    <div class="signal-card-meta">
      <span class="signal-tier {{ tier_cls }}">{{ tier_zh }}</span>
      {{ signal_age_badge(s) }}
      {% if url_str %}
        <a class="signal-source" href="{{ url_str }}" target="_blank" rel="noopener" title="{{ url_str }}">
          {% set parts = url_str.split('/') %}
          {% set host = parts[2] if parts|length >= 3 else url_str %}
          {{ host|replace('www.', '')|replace('m.', '') }}
        </a>
      {% endif %}
      {% if s.sentiment %}
        <span class="signal-sentiment signal-sentiment-{{ s.sentiment }}">
          {% if s.sentiment == 'positive' %}正面{% elif s.sentiment == 'negative' %}负面{% else %}中性{% endif %}
        </span>
      {% endif %}
    </div>
    <blockquote class="signal-evidence">"{{ s.evidence }}"</blockquote>
  </li>
{%- endmacro %}

{# --- Data source chip wall (本报告综合了 X 条信号 / Y 个平台) --- #}
{% macro source_chip_wall(sources) -%}
  {% set brand_map = {
    'zhihu.com': ('知', '知乎', '#0084ff'),
    'maimai.cn': ('脉', '脉脉', '#1a3a6e'),
    'kanzhun.com': ('看', '看准', '#ff6b35'),
    '36dianping.com': ('36', '看准点评', '#3eaf7c'),
    'nowcoder.com': ('牛', '牛客', '#34c759'),
    '1point3acres.com': ('亩', '一亩三分地', '#5b8def'),
    'zhipin.com': ('BOSS', 'BOSS直聘', '#00b1a5'),
    'lagou.com': ('拉', '拉勾', '#00b0ff'),
    'v2ex.com': ('V', 'V2EX', '#778899'),
    'douban.com': ('豆', '豆瓣', '#00b51d'),
    'weibo.com': ('微', '微博', '#e6162d'),
    'weixin.qq.com': ('信', '微信公众号', '#07c160'),
    'xiaohongshu.com': ('红', '小红书', '#ff2442'),
    'douyin.com': ('抖', '抖音', '#161823'),
    'bilibili.com': ('B', 'B站', '#fb7299'),
    '36kr.com': ('36', '36氪', '#4285f4'),
    'huxiu.com': ('虎', '虎嗅', '#222222'),
    'lieyunwang.com': ('猎', '猎云网', '#222222'),
    'chuangsanjia.com': ('创', '创业邦', '#222222'),
    'itjuzi.com': ('桔', 'IT桔子', '#ff6e00'),
    'qcc.com': ('查', '企查查', '#d32f2f'),
    'tianyancha.com': ('天', '天眼查', '#1976d2'),
    'aiqicha.baidu.com': ('爱', '爱企查', '#2932e1'),
    'wikipedia.org': ('维', '维基百科', '#999999'),
    'baike.baidu.com': ('百', '百度百科', '#2932e1'),
    'wenshu.court.gov.cn': ('判', '裁判文书', '#5d4037'),
    'gsxt.gov.cn': ('工', '国家工商', '#5d4037'),
    'sogou.com': ('搜', '搜狗微信', '#3a8c10'),
    'oschina.net': ('OS', 'OSChina', '#21b24b'),
    'juejin.cn': ('掘', '掘金', '#1e80c0'),
    'segmentfault.com': ('SF', '思否', '#009a61'),
    'csdn.net': ('CS', 'CSDN', '#c92027'),
    'freebuf.com': ('网', 'FreeBuf', '#2c3e50'),
    'kanxue.com': ('看', '看雪', '#0d4d8a'),
  } %}
  {% set ns = namespace(seen=[], chips=[]) %}
  {% for src in sources %}
    {% set host = src.domain.split('/')[0] if src.domain else '' %}
    {% set brand = brand_map.get(host) %}
    {% if brand and brand[0] not in ns.seen %}
      {% set ns.seen = ns.seen + [brand[0]] %}
      {% set ns.chips = ns.chips + [brand] %}
    {% endif %}
  {% endfor %}
  {% if ns.chips|length > 0 %}
  <div class="source-chip-wall" aria-label="本报告主要数据源">
    <span class="source-chip-wall-label">本报告综合了 {{ sources|length }} 条来源 · {{ ns.chips|length }} 个平台</span>
    <div class="source-chip-grid">
      {% for ch in ns.chips %}
      <span class="source-chip" style="--chip-color:{{ ch[2] }};" title="${ch[1]}">
        <span class="source-chip-mark">{{ ch[0] }}</span>
        <span class="source-chip-name">{{ ch[1] }}</span>
      </span>
      {% endfor %}
    </div>
  </div>
  {% endif %}
{%- endmacro %}

{# ============================================================
   1. MASTHEAD — research-report header bar
   ============================================================ #}
<header class="masthead">
  <div class="masthead-left">
    <span class="masthead-brand">jobHunter RESEARCH</span>
    <span class="masthead-tag">个人尽调备忘</span>
  </div>
  <div class="masthead-center">
    <span class="masthead-ticker">报告 №&nbsp;<span class="mono">{{ '%03d'|format(((data.generated_at.timestamp()|int) % 997) + 1) }}</span></span>
    {% set v = overall_verdict %}
    <span class="masthead-rating masthead-rating-{{ v.level }}" title="{{ v.headline }}">
      <span class="masthead-rating-dot"></span>
      {{ {'recommend':'增持','caution':'中性','avoid':'减持','neutral':'观察'}[v.level] }}
    </span>
  </div>
  <div class="masthead-right">
    <span class="mono">{{ data.generated_at.strftime('%Y-%m-%d') }}</span>
    <span class="masthead-week">第 {{ now.strftime('%V') }} 周</span>
  </div>
</header>

{# ============================================================
   2. COVER — investment-thesis block + KPI grid + radar + verdict
   ============================================================ #}
<section class="cover">

  {# --- Top: 标的 + 副标题 + 主编按 --- #}
  <div class="cover-top">
    <div class="cover-title-block">
      <div class="cover-edition">
        <span class="cover-edition-key">标的</span>
        <span class="cover-edition-position">{{ data.query.position or '岗位未指定' }}</span>
        <span class="cover-edition-sep">·</span>
        <span class="cover-edition-city">{{ data.query.city or '城市未指定' }}</span>
        {% set dimensions = (1 if data.company_profile else 0) + (1 if data.business_facts else 0) + (1 if data.review_facts else 0) + (1 if data.news_facts else 0) + (1 if data.judicial_facts else 0) %}
        <span class="cover-edition-meta">综合分 <span class="mono">{{ '%.1f'|format(avg_score) }}</span> / 5.0 · {{ dimensions }} 维度</span>
      </div>
      <h1 class="cover-title">
        <span class="cover-company">{{ data.query.company }}</span>
        <span class="cover-title-dek">一份关于 {{ data.query.company }} 的尽调备忘</span>
      </h1>
      {% if data.company_profile and (data.company_profile.business_scope or data.company_profile.motto) %}
      <p class="cover-summary">
        {% if data.company_profile.motto %}
          <span class="cover-motto">「{{ data.company_profile.motto }}」</span>
        {% endif %}
        {% if data.company_profile.business_scope %}
          <span class="cover-scope">{{ data.company_profile.business_scope }}</span>
        {% endif %}
      </p>
      {% endif %}
    </div>

    {# --- 主编按 editorial aside --- #}
    {% set dispatch_text = edit_notes.get('cover') or v.headline %}
    <aside class="cover-dispatch">
      <span class="cover-dispatch-tag">主编按</span>
      <div class="cover-dispatch-body">{{ dispatch_text }}</div>
      {% if v.reasons and v.reasons|length > 0 %}
      <ol class="cover-dispatch-reasons">
        {% for r in v.reasons[:3] %}
        <li>{{ r }}</li>
        {% endfor %}
      </ol>
      {% endif %}
    </aside>
  </div>

  {# --- Mid: 投资要点 (3-5 numbered bullets) --- #}
  <section class="thesis" aria-label="投资要点">
    <div class="thesis-head">
      <span class="thesis-head-label">投资要点</span>
      <span class="thesis-head-en">Investment Thesis</span>
    </div>
    <ol class="thesis-list">
      {% set thesis_items = data_stories.get('thesis') or [] %}
      {% if thesis_items|length > 0 %}
        {% for line in thesis_items %}
        <li class="thesis-item"><span class="thesis-num">{{ loop.index }}</span><span class="thesis-text">{{ line }}</span></li>
        {% endfor %}
      {% else %}
        {# Fallback: derive a few theses from data #}
        {% if data.overall_confidence %}
        <li class="thesis-item"><span class="thesis-num">1</span><span class="thesis-text">本备忘录数据置信度为「{{ {'high':'高','medium':'中','low':'低'}[data.overall_confidence] }}」, {{ dimensions }} 维度中 {{ (1 if data.company_profile else 0) + (1 if data.business_facts else 0) + (1 if data.review_facts else 0) + (1 if data.news_facts else 0) + (1 if data.judicial_facts else 0) }} 维度已抓取</span></li>
        {% endif %}
        <li class="thesis-item"><span class="thesis-num">2</span><span class="thesis-text">综合得分 <span class="mono">{{ '%.1f'|format(avg_score) }}</span> / 5.0, 见下方 5 轴雷达分布</span></li>
        <li class="thesis-item"><span class="thesis-num">3</span><span class="thesis-text">本页报告全部信号可溯源, 详见 Σ 来源附录</span></li>
      {% endif %}
    </ol>
  </section>

  {# --- Mid: KPI grid (3 columns) --- #}
  <section class="kpi-grid" aria-label="核心 KPI">
    {% set dims = (1 if data.company_profile else 0) + (1 if data.business_facts else 0) + (1 if data.review_facts else 0) + (1 if data.news_facts else 0) + (1 if data.judicial_facts else 0) %}
    <div class="kpi-cell">
      <div class="kpi-key">综合分</div>
      <div class="kpi-val mono">{{ '%.1f'|format(avg_score) }}<span class="kpi-unit"> / 5.0</span></div>
      <div class="kpi-sub">5 轴雷达均值</div>
    </div>
    <div class="kpi-cell">
      <div class="kpi-key">司法风险</div>
      <div class="kpi-val mono">
        {% if data.judicial_facts %}
          {{ data.judicial_facts.case_count_total or 0 }}<span class="kpi-unit"> 起</span>
        {% else %}
          —<span class="kpi-unit"></span>
        {% endif %}
      </div>
      <div class="kpi-sub">
        {% if data.judicial_facts and (data.judicial_facts.case_count_total or 0) == 0 %}
          公开记录中未见诉讼
        {% elif data.judicial_facts %}
          公开记录可查
        {% else %}
          本次未能取得
        {% endif %}
      </div>
    </div>
    <div class="kpi-cell">
      <div class="kpi-key">加班强度</div>
      <div class="kpi-val mono">
        {% if data.review_facts and data.review_facts.overtime_signals %}
          {{ data.review_facts.overtime_signals|length }}<span class="kpi-unit"> 证据</span>
        {% else %}
          —<span class="kpi-unit"></span>
        {% endif %}
      </div>
      <div class="kpi-sub">
        {% if data.review_facts and data.review_facts.typical_off_time %}
          典型下班 {{ data.review_facts.typical_off_time }}
        {% else %}
          UGC 真实体感
        {% endif %}
      </div>
    </div>
  </section>

  {# --- Mid: 5 axis radar + verdict + 薪酬 band --- #}
  <section class="cover-viz" aria-label="5 轴雷达 + 薪酬 band + 顶层判断">
    <div class="cover-radar">
      <div class="cover-radar-label">5 轴雷达</div>
      <div class="cover-radar-svg">{{ radar_svg | safe }}</div>
    </div>
    <div class="cover-verdict cover-verdict-{{ v.level }}">
      <div class="cover-verdict-level">{{ {'recommend':'增持','caution':'中性','avoid':'减持','neutral':'观察'}[v.level] }}</div>
      <div class="cover-verdict-headline">{{ v.headline }}</div>
      {% if v.reasons and v.reasons|length > 0 %}
      <ul class="cover-verdict-reasons">
        {% for r in v.reasons %}
        <li>{{ r }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% if salary_band %}
    <div class="cover-band">
      <div class="cover-band-label">薪酬 band</div>
      <div class="cover-band-row">
        <span class="cover-band-p25 mono">¥{{ salary_band.p25 }}K</span>
        <div class="cover-band-track">
          <div class="cover-band-fill" style="--p25:{{ ((salary_band.p25 - salary_band.p25) / (salary_band.p75 - salary_band.p25) * 100)|round(1) }}%; --p75:100%;"></div>
          <div class="cover-band-median" title="P50 中位">
            <span class="mono">¥{{ salary_band.p50 }}K</span>
          </div>
        </div>
        <span class="cover-band-p75 mono">¥{{ salary_band.p75 }}K</span>
      </div>
      <div class="cover-band-sub">中位偏上 10-15% 是议价空间</div>
    </div>
    {% endif %}
  </section>

  {# --- Bottom: data source chip wall + collector soft-fail notes + snapshot diff --- #}
  <section class="cover-foot">
    {{ source_chip_wall(sources) }}
    {% if data.collector_notes and (data.collector_notes.get('sogou_weixin') or data.collector_notes.get('gsxt') or data.collector_notes.get('wenshu')) %}
    <div class="collector-notes" aria-label="数据源软失败提示">
      {% if data.collector_notes.get('sogou_weixin') %}
        {% set sw_note = data.collector_notes.get('sogou_weixin') %}
        <span class="collector-note">
          ⚠ 搜狗微信搜索被反爬拦截 — 部分公众号内容未纳入。
          <a href="https://weixin.sogou.com/?query={{ data.query.company|urlencode }}" target="_blank" rel="noopener">手动核查 →</a>
          {% if 'no_results' in sw_note %}<span class="collector-note-detail">(静默封禁, 未拿到任何结果)</span>{% endif %}
        </span>
      {% endif %}
      {% if data.collector_notes.get('gsxt') %}
      <span class="collector-note">
        ⚠ 国家企业信用信息公示系统未能访问 — 工商数据可能不完整。
        <a href="https://www.gsxt.gov.cn/" target="_blank" rel="noopener">手动核查 →</a>
      </span>
      {% endif %}
      {% if data.collector_notes.get('wenshu') %}
      <span class="collector-note">
        ⚠ 裁判文书网未能访问 — 司法数据可能不完整。
        <a href="https://wenshu.court.gov.cn/" target="_blank" rel="noopener">手动核查 →</a>
      </span>
      {% endif %}
    </div>
    {% endif %}
    {% if snapshot_diff %}
    <div class="cover-snapshot" aria-label="vs 上次数据变化">
      <span class="cover-snapshot-tag">vs 上次</span>
      <span class="cover-snapshot-time">{{ snapshot_diff.days_ago }} 天前</span>
      <ul class="cover-snapshot-lines">
        {% if snapshot_diff.verdict_changed %}
        <li><span class="snap-key">判断</span><span class="snap-delta snap-delta-{{ snapshot_diff.verdict_changed }}">{{ snapshot_diff.verdict_changed }}</span></li>
        {% endif %}
        {% if snapshot_diff.case_delta %}
        <li><span class="snap-key">司法</span><span class="snap-delta mono">{{ snapshot_diff.case_delta }}</span></li>
        {% endif %}
        {% if snapshot_diff.salary_delta %}
        <li><span class="snap-key">薪酬 P50</span><span class="snap-delta mono">{{ snapshot_diff.salary_delta }}</span></li>
        {% endif %}
        {% if snapshot_diff.anomaly_changed %}
        <li><span class="snap-key">异常</span><span class="snap-delta">{{ snapshot_diff.anomaly_changed }}</span></li>
        {% endif %}
      </ul>
    </div>
    {% endif %}
  </section>

</section>

{# ============================================================
   3. MAIN — numbered chapters (I-VII)
   ============================================================ #}
<main class="chapters-container">

{# ============================================================
   I. 公司画像
   ============================================================ #}
<section class="chapter" id="ch-company" data-chapter-key="company">
  <header class="chapter-head">
    <div class="chapter-num">I</div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">公司画像 {{ conf_badge('company') }}</h2>
      <p class="chapter-dek">主营业务、产品矩阵、融资轨迹与规模 — 这家公司是谁</p>
    </div>
  </header>

  {{ story_block('company') }}

  {% set cp = data.company_profile %}
  {% if cp %}
  <div class="chapter-takeaway">
    <span class="chapter-takeaway-tag">一句话</span>
    {{ data.query.company }} 主营 {{ cp.industries[0] if cp.industries else '业务未抓取' }}{% if cp.founded_at %} · 成立 {{ cp.founded_at }}{% endif %}{% if cp.headquarters %} · 总部 {{ cp.headquarters }}{% endif %}
  </div>

  <div class="data-table">
    <div class="data-row">
      <div class="data-cell data-cell-key">主营业务</div>
      <div class="data-cell">{{ cp.business_scope or '—' }}</div>
    </div>
    <div class="data-row">
