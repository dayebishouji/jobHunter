      <div class="bar-v-count">{{ b.count }}</div>
      <div class="bar-v-fill" style="height:{% if max_count > 0 %}{{ (b.count / max_count * 100)|int }}{% else %}0{% endif %}%;"></div>
      <div class="bar-v-label">{{ b.label }}K</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endif %}
</section>

{# ====================== CHAPTER V — 加班与工作强度 ====================== #}
<section class="chapter" id="ch-overtime" draggable="true" data-chapter-key="reviews">
  <header class="chapter-head">
    <div class="chapter-num"><span class="drag-handle" aria-label="拖动以重排章节" title="拖动以重排章节">⋮⋮</span>V<span class="slash">/</span><span class="total">VI</span></div>
