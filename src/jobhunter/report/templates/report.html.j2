<section class="chapter" id="ch-news" data-chapter-key="news">
  <header class="chapter-head">
    <div class="chapter-num">VII</div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">近期舆情 {{ conf_badge('news') }}</h2>
      <p class="chapter-dek">最近新闻与公开信号 — 公司在公众眼中什么样</p>
    </div>
