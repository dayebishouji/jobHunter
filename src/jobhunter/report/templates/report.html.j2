      <div class="peer-cell peer-cell-num">司法</div>
      <div class="peer-cell peer-cell-num">舆情</div>
    </div>
    {% for p in peer_comparison %}
    <div class="peer-row {% if loop.first %}peer-row-target{% endif %}">
      <div class="peer-cell peer-cell-key">
        {% if loop.first %}<span class="peer-tag">标的</span>{% endif %}
        {{ p.name }}
      </div>
      <div class="peer-cell peer-cell-num mono">{{ '%.1f'|format(p.overall_score or 0) }}</div>
      <div class="peer-cell peer-cell-num mono">{% if p.salary_median_k %}¥{{ p.salary_median_k }}K{% else %}—{% endif %}</div>
      <div class="peer-cell peer-cell-num mono">{{ p.case_count_total or 0 }}</div>
      <div class="peer-cell peer-cell-num">{{ p.news_sentiment or '中性' }}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ============================================================
   Side chapter — JD 对照 (conditional)
   ============================================================ #}
{% if jd_alignment and jd_alignment|length > 0 %}
<section class="chapter chapter-side" id="ch-jd">
  <header class="chapter-head">
    <div class="chapter-num chapter-num-side">JD</div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">JD 对照清单</h2>
      <p class="chapter-dek">JD 里 15 类常见承诺 vs 公开事实 — confirmed / contradicted / unverified</p>
    </div>
  </header>

  <div class="jd-grid">
    {% for j in jd_alignment %}
    <div class="jd-cell jd-cell-{{ j.status }}">
      <div class="jd-cell-head">
        <span class="jd-cell-name">{{ j.claim }}</span>
        <span class="jd-cell-status">{{ {'confirmed':'已证实','contradicted':'已反驳','unverified':'未证实'}.get(j.status, j.status) }}</span>
      </div>
      {% if j.reasoning %}<div class="jd-cell-evidence">{{ j.reasoning }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ============================================================
   Side chapter — 数据缺口 + 综合推断
   ============================================================ #}
<section class="chapter chapter-side" id="ch-tail">
  <header class="chapter-head">
    <div class="chapter-num chapter-num-side">附</div>
    <div class="chapter-title-wrap">
      <h2 class="chapter-title">数据缺口 + 综合推断</h2>
      <p class="chapter-dek">诚实列出本次没拿到的维度, 以及基于现有事实的合理推断</p>
    </div>
  </header>

  <div class="side-section">
    <h3 class="subsection">数据缺口</h3>
    {% set gaps = data.data_gaps or [] %}
    {% if gaps|length > 0 %}
    <ul class="gap-list">
      {% for g in gaps %}
      <li class="gap-item">
        <span class="gap-name">{{ g }}</span>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="prose">本次未发现明显数据缺口。{{ (1 if data.company_profile else 0) + (1 if data.business_facts else 0) + (1 if data.review_facts else 0) + (1 if data.news_facts else 0) + (1 if data.judicial_facts else 0) }} / 5 维度已抓取。</p>
    {% endif %}
  </div>

  <div class="side-section">
    <h3 class="subsection">综合推断</h3>
    {% if v.reasons and v.reasons|length > 0 %}
    <ul class="infer-list">
      {% for inf in v.reasons %}
      <li class="infer-item">
        <div class="infer-body">{{ inf }}</div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="prose">本次未生成综合推断。</p>
    {% endif %}
  </div>
</section>

</main>

{# ============================================================
   4. 风险提示 — Risk Disclosure
   ============================================================ #}
<section class="risk-disclosure">
  <header class="risk-disclosure-head">
    <span class="risk-disclosure-tag">风险提示</span>
    <span class="risk-disclosure-en">Risk Factors</span>
  </header>
  <ol class="risk-list">
    <li class="risk-item">
      <div class="risk-item-head">本报告由 AI 生成, 仅供个人参考</div>
      <div class="risk-item-body">所有信号从公开渠道 (Tavily 搜索 + 公开工商 / 司法数据 + Claude 结构化抽取) 取得, 不构成任何投资或职业建议。请独立判断并自行核实关键事实。</div>
    </li>
    <li class="risk-item">
      <div class="risk-item-head">数据时效性</div>
      <div class="risk-item-body">搜索结果可能因时间推移而过期。报告生成时间见顶部 masthead, 关键事实建议复核后再决策。</div>
    </li>
    <li class="risk-item">
      <div class="risk-item-head">gsxt / wenshu 在非 CN IP 下软失败</div>
      <div class="risk-item-body">
        如工商 / 司法数据未能取得, 请手动到
        <a href="https://www.gsxt.gov.cn/" target="_blank" rel="noopener">国家企业信用信息公示系统</a> /
        <a href="https://wenshu.court.gov.cn/" target="_blank" rel="noopener">裁判文书网</a> /
        <a href="https://www.tianyancha.com/" target="_blank" rel="noopener">天眼查</a> 核查。
      </div>
    </li>
    <li class="risk-item">
      <div class="risk-item-head">隐私</div>
      <div class="risk-item-body">本报告不存储任何个人身份信息, 仅本地生成。可随时删除 reports/ 目录下的 .html 文件。</div>
    </li>
  </ol>
</section>

{# ============================================================
   5. Σ 来源附录
   ============================================================ #}
<section class="appendix">
  <header class="appendix-head">
    <span class="appendix-tag">Σ 来源附录</span>
    <span class="appendix-meta">{{ sources|length }} 条 · 按来源平台分组</span>
  </header>
  <ul class="appendix-list">
    {% for src in sources %}
    <li class="appendix-item">
      <span class="appendix-domain">{{ src.domain }}</span>
      <a class="appendix-url" href="{{ src.url }}" target="_blank" rel="noopener">{{ src.title or src.url }}</a>
    </li>
    {% endfor %}
  </ul>
</section>

<footer class="footnote">
  <span class="footnote-brand">jobHunter RESEARCH</span>
  <span class="footnote-meta">生成于 {{ data.generated_at.strftime('%Y-%m-%d %H:%M') }} · 本次跑 Tavily credits ≈ {{ sources|length }}</span>
</footer>

</div>

<script>
{# ============================================================
   Inline JS — minimal motion + drag-and-drop + KPI counter ticker
   No external deps. prefers-reduced-motion respected.
   ============================================================ #}
(function() {
  'use strict';
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReduced) return;

  // ----- Chapter drag-and-drop -----
  var container = document.querySelector('.chapters-container');
  if (container) {
    var dragSrc = null;
    container.querySelectorAll('.chapter[draggable]').forEach(function(ch) {
      ch.setAttribute('draggable', 'true');
      ch.addEventListener('dragstart', function(e) {
        dragSrc = ch;
        ch.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', ch.id);
      });
      ch.addEventListener('dragend', function() {
        ch.classList.remove('dragging');
        container.querySelectorAll('.chapter').forEach(function(c) { c.classList.remove('drag-over'); });
      });
      ch.addEventListener('dragover', function(e) { e.preventDefault(); ch.classList.add('drag-over'); });
      ch.addEventListener('dragleave', function() { ch.classList.remove('drag-over'); });
      ch.addEventListener('drop', function(e) {
        e.preventDefault();
        ch.classList.remove('drag-over');
        if (dragSrc && dragSrc !== ch) {
          var rect = ch.getBoundingClientRect();
          var after = (e.clientY - rect.top) > rect.height / 2;
          container.insertBefore(dragSrc, after ? ch.nextSibling : ch);
          try {
            var order = Array.prototype.slice.call(container.querySelectorAll('.chapter')).map(function(c){return c.id;});
            localStorage.setItem('jobhunter:chapter-order', JSON.stringify(order));
          } catch (e2) {}
        }
      });
    });
    try {
      var saved = JSON.parse(localStorage.getItem('jobhunter:chapter-order') || 'null');
      if (saved && Array.isArray(saved)) {
        saved.forEach(function(id) {
          var el = document.getElementById(id);
          if (el && el.parentNode === container) container.appendChild(el);
        });
      }
    } catch (e3) {}
  }

  // ----- Scroll reveal -----
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(en) {
        if (en.isIntersecting) {
          en.target.classList.add('reveal');
          io.unobserve(en.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
    document.querySelectorAll('.chapter, .kpi-cell, .inline-viz, .risk-item, .appendix-item').forEach(function(el) {
      io.observe(el);
    });
  } else {
    document.querySelectorAll('.chapter, .kpi-cell, .inline-viz, .risk-item, .appendix-item').forEach(function(el) {
      el.classList.add('reveal');
    });
  }

  // ----- KPI counter ticker (easeOutCubic) -----
  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
  function animateNumber(el, target, decimals) {
    var start = performance.now();
    var dur = 1100;
    function step(now) {
      var t = Math.min((now - start) / dur, 1);
      var eased = easeOutCubic(t);
      var val = target * eased;
      el.textContent = decimals ? val.toFixed(decimals) : Math.round(val);
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  if ('IntersectionObserver' in window) {
    var ioNum = new IntersectionObserver(function(entries) {
      entries.forEach(function(en) {
        if (!en.isIntersecting) return;
        var el = en.target;
        var txt = el.textContent.trim();
        var match = txt.match(/^([\-\d.]+)/);
        if (match) {
          var raw = match[1];
          var target = parseFloat(raw);
          var decimals = (raw.split('.')[1] || '').length;
          animateNumber(el, target, decimals);
        }
        ioNum.unobserve(el);
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('.kpi-val, .cover-band-p25, .cover-band-p75, .salary-band-end').forEach(function(el) {
      ioNum.observe(el);
    });
  }

  // ----- Print trigger (?print=1) -----
  var params = new URLSearchParams(window.location.search);
  if (params.get('print') === '1') {
    setTimeout(function() { window.print(); }, 600);
  }
})();
</script>

</body>
</html>