    </div>
  </header>
  {{ story_block('reviews') }}

  {% set r = data.review_facts %}
  {% if not r or not r.overtime_signals %}
    <p class="empty">暂无加班节奏信号。</p>
  {% else %}
  <h3 class="serif" style="font-size:20px;margin:0 0 10px;">节奏模式分布</h3>
