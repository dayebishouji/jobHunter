  {% set vibe_pos = vibe_counts|selectattr('tone', 'eq', 'good')|list|length %}
  {% set vibe_neg = vibe_counts|selectattr('tone', 'eq', 'bad')|list|length %}
  {% set vibe_neu = vibe_counts|selectattr('tone', 'eq', 'neutral')|list|length %}
