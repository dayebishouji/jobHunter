      </div>
      <a class="news-item-title" href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a>
      {% if it.summary %}<p class="news-item-summary">{{ it.summary }}</p>{% endif %}
    </li>
    {% endfor %}
