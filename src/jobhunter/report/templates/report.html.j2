      <span class="dist-row-label">{{ o.pattern }}</span>
      <span class="dist-row-bar">
        <span class="dist-row-fill tone-{{ {'high':'bad','medium':'warn','low':'good'}[o.intensity] }}"
              style="width:{% if total > 0 %}{{ (o.count / total * 100)|int }}{% else %}0{% endif %}%;"></span>
      </span>
      <span class="dist-row-meta">{{ o.count }}<span class="pct"> · {{ o.pct }}%</span></span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <h3 class="serif" style="font-size:20px;margin:28px 0 10px;">原始爆料</h3>
  <ul class="bullets">
    {% for o in r.overtime_signals %}
    <li>
      <span class="chip chip-{{ {'high':'bad','medium':'warn','low':'good'}[o.intensity] }}">{{ o.pattern }} · {{ {'high':'重','medium':'中','low':'轻'}[o.intensity] }}</span>
      {% set sup = signal_supports.get(o.url|string, {}) %}
      {% set tier = sup.get('support_tier', 'unverified') %}
      {% set tlabel = tier_label[tier][0] %}
      {% set tclass = tier_label[tier][1] %}
      <span class="tier-badge {{ tclass }}" title="{{ sup.get('support_count', 0) }} 个来源 / {{ sup.get('domains', [])|join(' · ') }}">{{ tlabel }}{% if sup.get('support_count', 0) > 1 %} ×{{ sup.support_count }}{% endif %}</span>
      {% if o.url %} · <a href="{{ o.url }}" target="_blank" rel="noopener">来源</a>{% endif %}
      {% if o.evidence %}
        <blockquote class="evidence">"{{ o.evidence }}"</blockquote>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if r and r.slang_glossary %}
  <div class="slang-glossary" aria-label="网络词解读">
    <div class="slang-glossary-head">
      <span class="slang-glossary-num">F</span>
      <span class="slang-glossary-title">网络词解读</span>
      <span class="slang-glossary-dek">原帖里出现的口语 / 互联网表达</span>
    </div>
    <dl class="slang-list">
      {% for s in r.slang_glossary %}
      <div class="slang-row">
        <dt class="slang-term">
          <span class="slang-word">{{ s.term }}</span>
          {% if s.count and s.count > 1 %}<span class="slang-count">×{{ s.count }}</span>{% endif %}
        </dt>
        <dd class="slang-meaning">
          {{ s.meaning or '—' }}
          {% if s.url %}<a class="slang-src" href="{{ s.url }}" target="_blank" rel="noopener">来源</a>{% endif %}
        </dd>
      </div>
      {% endfor %}
    </dl>
  </div>
  {% endif %}
</section>

{# ====================== CHAPTER VI — 团队氛围 ====================== #}
<section class="chapter" id="ch-vibe" draggable="true" data-chapter-key="reviews">
