# jobHunter — API keys
# 复制为 .env 并填入真实 key（.env 已在 .gitignore，不会被提交）

# Anthropic Claude API（https://console.anthropic.com/）
ANTHROPIC_API_KEY=

# Anthropic 自定义 endpoint —— 用 ccswitch / one-api / 其它中转时填，否则留空
# 例子：https://api.ccswitch.org/v1  或  https://your-relay.example.com
ANTHROPIC_BASE_URL=

# Tavily Search API（https://tavily.com/）
TAVILY_API_KEY=

# 可选：覆盖默认模型
# JOBHUNTER_MODEL=claude-sonnet-4-5

# 可选：缓存 TTL（小时）
# JOBHUNTER_CACHE_TTL_HOURS=24

# 可选：单次运行的 LLM token 预算
# JOBHUNTER_BUDGET_TOKENS=200000
